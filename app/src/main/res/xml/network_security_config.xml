<?xml version="1.0" encoding="utf-8"?>
<!-- IPTV yayınlarının çoğu http kullanır; düz http'ye izin ver -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
